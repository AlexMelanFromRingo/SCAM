# Two local relay nodes with RPC UI, no Stratum and no miner.
LAUNCH_SCRIPT=scripts/local-test-lab.sh
NETWORK=devnet
CONFIG=config/devnet.toml
CLUSTER_DIR=target/presets/lab-node-only
NODE_COUNT=2
BUILD=false
CARGO_PROFILE=debug

LAB_RUN_RPC=true
LAB_RUN_STRATUM=false
RUN_MINER=false
GENERATE_WALLETS=false

RELAY_OUTBOUND_CONNECT=true
RUN_SYNC_LOOP=true
SYNC_LOOP_INTERVAL_SEC=2
SYNC_MAX_BATCHES_PER_PEER=8
