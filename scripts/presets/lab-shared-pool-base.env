# Shared-pool base lab: local Stratum on node-0 and one worker attached.
# Add extra workers by starting additional `stratum-mine` processes manually.
LAUNCH_SCRIPT=scripts/local-test-lab.sh
NETWORK=devnet
CONFIG=config/devnet.toml
CLUSTER_DIR=target/presets/lab-shared-pool-base
NODE_COUNT=2
BUILD=false
CARGO_PROFILE=debug

LAB_RUN_RPC=true
LAB_RUN_STRATUM=true
RUN_MINER=true
MINER_TARGET_NODE=0
MINER_USER=pool-worker-01
MINER_MAX_SHARES=0
MINER_MAX_RUNTIME_SEC=0
GENERATE_WALLETS=true

RELAY_OUTBOUND_CONNECT=true
RUN_SYNC_LOOP=true
SYNC_LOOP_INTERVAL_SEC=2
SYNC_MAX_BATCHES_PER_PEER=8
