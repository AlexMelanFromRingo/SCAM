# Shared pool profile (alias for lab-shared-pool-base) with one local worker.
# Add more workers via:
#   target/debug/scam-node stratum-mine --pool 127.0.0.1:19347 --user worker-02
LAUNCH_SCRIPT=scripts/local-test-lab.sh
NETWORK=devnet
CONFIG=config/devnet.toml
CLUSTER_DIR=target/presets/lab-pool-shared
NODE_COUNT=2
BUILD=false
CARGO_PROFILE=debug

LAB_RUN_RPC=true
LAB_RUN_STRATUM=true
RUN_MINER=true
MINER_TARGET_NODE=0
MINER_USER=pool-worker-01
MINER_MAX_SHARES=0
MINER_MAX_RUNTIME_SEC=0
GENERATE_WALLETS=true

RELAY_OUTBOUND_CONNECT=true
RUN_SYNC_LOOP=true
SYNC_LOOP_INTERVAL_SEC=2
SYNC_MAX_BATCHES_PER_PEER=8
